    {
      "parameters": {
        "jsCode": "const comments = $input.first().all();\nconst keywords = $input.last().all();\nconst matchedComments = [];\n\nfor (const comment of comments) {\n  const commentText = (comment.json.text || '').toLowerCase();\n  \n  for (const keywordRow of keywords) {\n    const keyword = (keywordRow.json['Keyword'] || '').toLowerCase();\n    const replyMessage = keywordRow.json['Reply Message'] || '';\n    const dmMessage = keywordRow.json['DM Message'] || '';\n    \n    if (commentText.includes(keyword) && keyword !== '') {\n      matchedComments.push({\n        json: {\n          comment_id: comment.json.id,\n          comment_text: comment.json.text,\n          commenter_id: comment.json.from?.id,\n          commenter_username: comment.json.from?.username,\n          keyword_matched: keyword,\n          reply_message: replyMessage,\n          dm_message: dmMessage,\n          timestamp: comment.json.timestamp\n        }\n      });\n      break;\n    }\n  }\n}\n\nreturn matchedComments;"
      },
