    {
      "parameters": {
        "jsCode": "const webhookData = $input.item.json;\nconst payload = webhookData.entry?.[0]?.messaging?.[0]?.postback?.payload;\nconst senderId = webhookData.entry?.[0]?.messaging?.[0]?.sender?.id;\n\nif (payload === 'CHECK_FOLLOW_STATUS' && senderId) {\n  return {\n    json: {\n      commenter_id: senderId,\n      action: 'check_follow'\n    }\n  };\n}\n\nreturn { json: {} };"
      },
