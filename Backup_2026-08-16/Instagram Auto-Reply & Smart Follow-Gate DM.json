    {
      "parameters": {
        "jsCode": "const followersData = $input.first().item.json;\nconst commenterData = $input.last().item.json;\n\nconst followersList = followersData.data || [];\nconst commenterId = commenterData.commenter_id;\n\nconst isFollowing = followersList.some(follower => follower.id === commenterId);\n\nreturn {\n  json: {\n    ...commenterData,\n    is_following: isFollowing,\n    followers_count: followersList.length\n  }\n};"
      },
