    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\n// Sort rows by row number to maintain order\nrows.sort((a, b) => (a.json.row_number || 0) - (b.json.row_number || 0));\n\n// Build history in AI → User → AI → User format\nconst history = [];\n\nfor (const r of rows) {\n  const aiReply = r.json[\"AI reply\"] || \"\";\n  const userMsg = r.json[\"User message\"] || \"\";\n\n  if (aiReply.trim() !== \"\") {\n    history.push({ role: \"AI\", text: aiReply.trim() });\n  }\n  if (userMsg.trim() !== \"\") {\n    history.push({ role: \"User\", text: userMsg.trim() });\n  }\n}\n\n// Add NEW incoming message from Instagram webhook\nconst newUserMsg =\n  $node[\"Instagram DM1\"].json.body.entry[0].messaging[0]?.message?.text\n  || \"[No text]\";\n\nhistory.push({ role: \"User\", text: newUserMsg.trim() });\n\n// Build FULL conversation log as readable string\nconst conversationLog = history\n  .map(h => `${h.role}: ${h.text}`)\n  .join(\" | \");\n\n// Take last 5 exchanges = 10 messages max\nconst last5Exchanges = history.slice(-10);\n\n// Convert last 5 exchanges into CHAT TEXT (not array)\nconst last5Formatted = last5Exchanges\n  .map(h => `${h.role}: ${h.text}`)\n  .join(\"\\n\");\n\nreturn [{\n  json: {\n    sender_id: $node[\"Extracts ID1\"].json[\"body.entry[0].messaging[0].sender.id\"],\n    conversation_log: conversationLog,\n    last_5_messages: last5Formatted\n  }\n}];\n"
      },
