    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n\n  let reply = (item.json.reply || \"\").toString();\n\n  const senderId =\n    $('Extracts ID1')\n      .first()\n      .json\n      .body\n      .entry[0]\n      .messaging[0]\n      .sender\n      .id;\n\n  // STEP 1: Convert escaped newlines to real newlines\n  reply = reply.replace(/\\\\n/g, \"\\n\");\n\n  // STEP 2: Append sid ONLY to real URLs\n  reply = reply.replace(\n    /(https?:\\/\\/[^\\s]+)/g,\n    (url) => {\n      if (url.includes(\"sid=\")) return url;\n      return `${url}?sid=${senderId}`;\n    }\n  );\n\n  // STEP 3: Convert real newlines back to escaped newlines\n  reply = reply.replace(/\\n/g, \"\\\\n\");\n\n  results.push({\n    json: {\n      reply,\n      sid: senderId\n    }\n  });\n}\n\nreturn results;\n"
      },
