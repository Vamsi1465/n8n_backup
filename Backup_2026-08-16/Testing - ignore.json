    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n\n  const reply = (item.json.reply || \"\").toString();\n\n  // Match any real URL (http or https)\n  const urlPattern = /(https?:\\/\\/[^\\s]+)/i;\n\n  const has_booking_link = urlPattern.test(reply);\n\n  results.push({\n    json: {\n      reply: reply,\n      has_booking_link: has_booking_link\n    }\n  });\n}\n\nreturn results;\n"
      },
