      "id": "df7c02e2-a92a-4035-9f61-a3d090ddcaf4",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n\n  let data;\n\n  if (typeof item.json.output === \"string\") {\n    try {\n      data = JSON.parse(item.json.output);\n    } catch (e) {\n      continue;\n    }\n  } else {\n    data = item.json.output || item.json;\n  }\n\n  if (!data || !data.type) continue;\n\n  let istDate = \"\";\n  if (data.date) {\n    const dateObj = new Date(data.date);\n    istDate = dateObj.toLocaleDateString(\"en-CA\", {\n      timeZone: \"Asia/Kolkata\"\n    });\n  }\n\n  results.push({\n    json: {\n      type: data.type.toLowerCase(),\n      date: istDate,\n      name: data.name || \"\",\n      category: data.category || \"\",\n      amount: Number(data.amount) || 0,\n      payment_mode: data.payment_mode || \"\",\n      reason: data.reason || \"\"\n    }\n  });\n}\n\nreturn results;\n"
      },
