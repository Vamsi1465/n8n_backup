        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nconst msg =\n  $json.body?.entry?.[0]?.messaging?.[0]?.message;\n\nconst mid = msg?.mid;\n\nif (!mid) {\n  return [];\n}\n\nif (!staticData.processed) {\n  staticData.processed = {};\n}\n\nif (staticData.processed[mid]) {\n  return [];\n}\n\nstaticData.processed[mid] = Date.now();\n\nfor (const k in staticData.processed) {\n  if (Date.now() - staticData.processed[k] > 120000) {\n    delete staticData.processed[k];\n  }\n}\n\nreturn [$json];\n"
      },
