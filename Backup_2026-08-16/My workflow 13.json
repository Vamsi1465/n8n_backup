    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n\n  let reply = \"\";\n  const output = item.json?.output;\n\n  if (!output || output.toString().trim() === \"\") {\n    continue;\n  }\n\n  let raw = output.toString().trim();\n\n  // Remove leading \"json\" if present\n  if (raw.startsWith(\"json\")) {\n    raw = raw.replace(/^json/, \"\").trim();\n  }\n\n  // Remove markdown fences if any\n  raw = raw.replace(/```json|```/g, \"\").trim();\n\n  try {\n    const parsed = JSON.parse(raw);\n    reply = parsed.reply || \"\";\n  } catch (e) {\n    reply = raw;\n  }\n\n  if (!reply || reply.toString().trim() === \"\") {\n    continue;\n  }\n\n  // Normalize spacing, remove extra gaps\n  reply = reply\n    .replace(/\\r\\n/g, \"\\n\")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .replace(/[ \\t]+\\n/g, \"\\n\")\n    .trim();\n\n  // 🔴 CRITICAL FIX: make text JSON-safe\n  reply = reply.replace(/\\n/g, \"\\\\n\");\n\n  results.push({\n    json: {\n      reply: reply\n    }\n  });\n}\n\nreturn results;\n"
      },
