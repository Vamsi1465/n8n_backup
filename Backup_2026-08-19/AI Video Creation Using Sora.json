    {
      "parameters": {
        "jsCode": "const faceItems = $items(\"Edit Image\", 0, 0);\nconst productItems = $items(\"Edit Image1\", 0, 0);\n\nif (!faceItems || faceItems.length === 0) {\n  throw new Error(\"No items found from Edit Image (FACE)\");\n}\n\nif (!productItems || productItems.length === 0) {\n  throw new Error(\"No items found from Edit Image1 (PRODUCT)\");\n}\n\n// FACE binary\nconst faceBinary =\n  faceItems[0].binary?.upload_image ||\n  faceItems[0].binary?.image ||\n  faceItems[0].binary?.Upload_product ||\n  faceItems[0].binary?.data;\n\n// PRODUCT binary\nconst productBinary =\n  productItems[0].binary?.upload_image ||\n  productItems[0].binary?.image ||\n  productItems[0].binary?.Upload_product ||\n  productItems[0].binary?.data;\n\nif (!faceBinary) throw new Error(\"FACE image missing\");\nif (!productBinary) throw new Error(\"PRODUCT image missing\");\n\nreturn [\n  {\n    json: {},\n    binary: {\n      image: faceBinary,\n      product_image: productBinary\n    }\n  }\n];\n"
      },
